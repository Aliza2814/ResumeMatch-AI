# ResumeMatch AI Configuration
APP_NAME=ResumeMatch AI
APP_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL with SQLite fallback)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resumematch_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# SQLite Fallback (used if PostgreSQL is unavailable)
SQLITE_DB_PATH=data/resumematch.db

# Model Paths
MODEL_DIR=models/
DATA_DIR=data/
